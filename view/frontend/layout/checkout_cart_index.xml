<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="mygento_metrika">
            <block class="Mygento\Metrika\Block\Tracker\Impression" name="mygento_metrika_crosssell_products_impression" template="Mygento_Metrika::impression.phtml">
                <arguments>
                    <argument name="list_type" xsi:type="string">crosssell</argument>
                    <argument name="block_name" xsi:type="string">checkout.cart.crosssell</argument>
                    <argument name="product_selector" xsi:type="string">.product-item-info</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
